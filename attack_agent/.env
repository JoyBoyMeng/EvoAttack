# Attack-agent train LLM routing.
# Default:
# - attack policy / attack text LLM uses the local vLLM server.
# - target agent LLM and target memory LLM/embedding use the external API relay.

# Attack agent: strategy policy and attack text generation.
POLICY_LLM_NAME=qwen3-32b
POLICY_OPENAI_API_KEY=EMPTY
POLICY_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# Unified switch for policy, attack text, target agent, and Mem0 inference.
ENABLE_THINKING=0

# Target agent: ASB target-agent execution.
# ATTACK_TARGET_LLM_NAME=Qwen/Qwen3-32B
# ATTACK_TARGET_OPENAI_COMPATIBLE=1
# ATTACK_TARGET_OPENAI_API_KEY=sk-2n2nZToIjSJi6nLQQ32Or68759mUzt7BLiftEpSsgIvMYsxm
# ATTACK_TARGET_OPENAI_BASE_URL=http://35.220.164.252:3888/v1
ATTACK_TARGET_LLM_NAME=qwen3-32b
ATTACK_TARGET_OPENAI_COMPATIBLE=1
ATTACK_TARGET_OPENAI_API_KEY=EMPTY
ATTACK_TARGET_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
TARGET_MAX_TOKENS_LIMIT=16384

# Target memory: default train flow does not enable Mem0 inference, so this LLM
# is only used if --target_mem0_infer is set.
# ATTACK_INIT_MEMORY_NAME=target_agent_mem0_system_admin_agent_init_v03
# ATTACK_TRAIN_TARGET_MEM0_PATH=memory_db/target_agent_mem0_system_admin_agent_init_v03_4attacktrain
# ATTACK_TEST_TARGET_MEM0_PATH=memory_db/target_agent_mem0_system_admin_agent_init_v03_4attacktest
# ATTACK_TARGET_MEM0_COLLECTION=asb_mem0_normal_system_admin_agent
# ATTACK_TARGET_MEM0_USER_ID=asb_normal_system_admin_agent

# MEM0_LLM_MODEL=Qwen/Qwen3-32B
# MEM0_LLM_API_KEY=sk-2n2nZToIjSJi6nLQQ32Or68759mUzt7BLiftEpSsgIvMYsxm
# MEM0_LLM_BASE_URL=http://35.220.164.252:3888/v1
MEM0_LLM_MODEL=qwen3-32b
MEM0_LLM_API_KEY=EMPTY
MEM0_LLM_BASE_URL=http://127.0.0.1:8000/v1

MEM0_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
MEM0_EMBEDDING_API_KEY=sk-2n2nZToIjSJi6nLQQ32Or68759mUzt7BLiftEpSsgIvMYsxm
MEM0_EMBEDDING_BASE_URL=http://35.220.164.252:3888/v1

# Keep localhost out of proxy; do not add 35.220.164.252 here if embedding/API
# calls should go through the proxy.
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost
